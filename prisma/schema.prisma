generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ModuleType {
  ACADEMIC
  STUDENTS
  ADMISSIONS
  FACULTY
  ATTENDANCE
  EXAMINATIONS
  RESULTS
  FEES
  FINANCE
  SCHOLARSHIPS
  CLINICAL_TRAINING
  HOSPITAL
  PATIENT_MANAGEMENT
  PHARMACY
  LABORATORY
  HOSTEL
  LIBRARY
  TRANSPORT
  CAFETERIA
  HR
  PAYROLL
  INVENTORY
  PROCUREMENT
  COMMUNICATION
  WEBSITE
  EVENTS
  DOCUMENTS
  ALUMNI
  CERTIFICATES
  REPORTS
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITING_LIST
  ENROLLED
}

enum ApplicationType {
  ONLINE
  OFFLINE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  DROPPED_OUT
  TRANSFERRED
  EXPELLED
  WITHDRAWN
}

enum SemesterType {
  FALL
  SPRING
  SUMMER
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  LEAVE
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
  PRACTICAL
  VIVA
  INTERNAL
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ResultStatus {
  PASS
  FAIL
  ABSENT
  INCOMPLETE
}

enum FeeType {
  ADMISSION
  TUITION
  EXAMINATION
  CLINICAL
  LIBRARY
  HOSTEL
  TRANSPORT
  REGISTRATION
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  CHEQUE
  OTHER
}

enum ScholarshipType {
  MERIT
  NEED_BASED
  SPORTS
  SPECIAL
  OTHER
}

enum ClinicalStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SkillStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum DocumentType {
  CNIC
  PASSPORT
  BIRTH_CERTIFICATE
  PHOTO
  EDUCATIONAL_CERTIFICATE
  TRANSCRIPT
  DOMICILE
  MEDICAL_CERTIFICATE
  ADMISSION_LETTER
  FEE_RECEIPT
  RESULT_CARD
  CHARACTER_CERTIFICATE
  OTHER
}

enum NotificationType {
  SYSTEM
  ADMISSION
  FEE
  ATTENDANCE
  EXAM
  RESULT
  NOTICE
  CLINICAL
  GENERAL
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RoomType {
  CLASSROOM
  LAB
  OFFICE
  AUDITORIUM
  LIBRARY
  CLINICAL
  OTHER
}

enum ClinicalSiteType {
  HOSPITAL
  CLINIC
  COMMUNITY_CENTER
  HEALTH_CENTER
  OTHER
}

enum HospitalDepartmentType {
  OPD
  EMERGENCY
  SURGERY
  MEDICINE
  PEDIATRICS
  GYNECOLOGY
  ICU
  NICU
  OTHER
}

enum PatientStatus {
  ACTIVE
  DISCHARGED
  DECEASED
  TRANSFERRED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LabTestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum HostelStatus {
  ACTIVE
  INACTIVE
}

enum RoomAllocationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LibraryItemStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  RESERVED
}

enum IssueStatus {
  ISSUED
  RETURNED
  LOST
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum HospitalBedType {
  GENERAL
  ICU
  SEMI_PRIVATE
  PRIVATE
  EMERGENCY
}

enum HostelRoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  MAINTENANCE
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  REVERSED
  CANCELLED
}

enum MedicineMovementType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DISPENSE
  RETURN
  EXPIRED
  DAMAGED
}

enum StockMovementType {
  PURCHASE
  SALE
  ISSUE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRY
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum CertificateType {
  BONAFIDE
  CHARACTER
  TRANSCRIPT
  COURSE_COMPLETION
  EXPERIENCE
  OTHER
}

// One database belongs to exactly one college. Deploy this schema independently
// for every college. There is intentionally NO collegeId on operational models.
model College {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  slug        String   @unique
  logoUrl     String?
  faviconUrl  String?
  description String?
  email       String?
  phone       String?
  website     String?
  address     String?
  city        String?
  province    String?
  country     String   @default("Pakistan")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings CollegeSettings?
  modules  CollegeModule[]
}

model CollegeSettings {
  id        String @id @default(cuid())
  collegeId String @unique
  timezone  String @default("Asia/Karachi")
  currency  String @default("PKR")
  gradingSystem      Json?
  attendanceSettings Json?
  admissionSettings  Json?
  feeSettings        Json?
  websiteSettings    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CollegeModule {
  id        String @id @default(cuid())
  module    ModuleType @unique
  enabled   Boolean @default(false)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  collegeId String
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String?
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roles UserRole[]
  student Student?
  parent Parent?
  faculty Faculty?
  employee Employee?
  notifications Notification[]
  auditLogs AuditLog[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id String @id @default(cuid())
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
}

model Permission {
  id String @id @default(cuid())
  module ModuleType
  action PermissionAction
  resource String
  description String?
  roles RolePermission[]
  @@unique([module, action, resource])
}

model RolePermission {
  id String @id @default(cuid())
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model Campus {
  id String @id @default(cuid())
  name String
  code String @unique
  address String?
  city String?
  phone String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buildings Building[]
  students Student[]
  faculty Faculty[]
}

model Building {
  id String @id @default(cuid())
  campusId String
  name String
  code String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  rooms Room[]
}

model Room {
  id String @id @default(cuid())
  buildingId String
  name String
  roomNumber String?
  type RoomType
  capacity Int?
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  timetables Timetable[]
  classes ClassSection[]
}

model Department {
  id String @id @default(cuid())
  name String
  code String @unique
  description String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programs Program[]
  faculty Faculty[]
  subjects Subject[]
  employees Employee[]
}

model Program {
  id String @id @default(cuid())
  departmentId String
  name String
  code String @unique
  description String?
  durationYears Int?
  totalCredits Int?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students Student[]
  semesters Semester[]
  subjects Subject[]
  applications AdmissionApplication[]
  feeStructures FeeStructure[]
}

model AcademicSession {
  id String @id @default(cuid())
  name String @unique
  startDate DateTime
  endDate DateTime
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  semesters Semester[]
  classes ClassSection[]
}

model Semester {
  id String @id @default(cuid())
  academicSessionId String
  programId String
  name String
  number Int
  type SemesterType
  status SemesterStatus @default(UPCOMING)
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  subjects SemesterSubject[]
  classes ClassSection[]
  exams Exam[]
  enrollments StudentEnrollment[]
  feeStructures FeeStructure[]
  @@unique([programId, academicSessionId, number])
}

model Subject {
  id String @id @default(cuid())
  departmentId String
  programId String?
  name String
  code String @unique
  description String?
  creditHours Int @default(3)
  theoryHours Int @default(0)
  practicalHours Int @default(0)
  isClinical Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  semesters SemesterSubject[]
  classes ClassSubject[]
  exams Exam[]
  results Result[]
  skills NursingSkill[]
  studentAttendance StudentAttendance[]
}

model SemesterSubject {
  id String @id @default(cuid())
  semesterId String
  subjectId String
  isMandatory Boolean @default(true)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([semesterId, subjectId])
}

model Faculty {
  id String @id @default(cuid())
  userId String @unique
  departmentId String
  campusId String?
  employeeId String @unique
  designation String?
  qualification String?
  specialization String?
  joiningDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classSubjects ClassSubject[]
  exams Exam[]
  attendance FacultyAttendance[]
  clinicalSupervisions ClinicalTraining[] @relation("ClinicalSupervisor")
  skillsVerified StudentSkill[] @relation("SkillVerifier")
}

model Parent {
  id String @id @default(cuid())
  userId String @unique
  occupation String?
  relationship String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentParent[]
}

model Student {
  id String @id @default(cuid())
  userId String @unique
  programId String
  campusId String?
  studentId String @unique
  admissionDate DateTime
  dateOfBirth DateTime?
  gender Gender?
  bloodGroup String?
  nationality String?
  religion String?
  cnic String?
  phone String?
  address String?
  city String?
  province String?
  postalCode String?
  status StudentStatus @default(ACTIVE)
  emergencyName String?
  emergencyPhone String?
  emergencyRelation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  parents StudentParent[]
  enrollments StudentEnrollment[]
  attendance StudentAttendance[]
  results Result[]
  payments Payment[]
  scholarships StudentScholarship[]
  documents StudentDocument[]
  clinicalTrainings ClinicalTraining[]
  skills StudentSkill[]
  hostelAllocations HostelAllocation[]
  libraryMembers LibraryMember[]
  libraryIssues LibraryIssue[]
  transportAssignments TransportAssignment[]
  certificates Certificate[]
  alumni Alumni?
}

model StudentParent {
  id String @id @default(cuid())
  studentId String
  parentId String
  isPrimary Boolean @default(false)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@unique([studentId, parentId])
}

model ClassSection {
  id String @id @default(cuid())
  academicSessionId String
  semesterId String
  name String
  roomId String?
  capacity Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  students StudentEnrollment[]
  subjects ClassSubject[]
  timetable Timetable[]
  attendance StudentAttendance[]
  @@unique([semesterId, name])
}

model StudentEnrollment {
  id String @id @default(cuid())
  studentId String
  semesterId String
  classId String
  status EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  class ClassSection @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@unique([studentId, semesterId])
}

model ClassSubject {
  id String @id @default(cuid())
  classId String
  subjectId String
  facultyId String?
  class ClassSection @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  timetable Timetable[]
  @@unique([classId, subjectId])
}

model Timetable {
  id String @id @default(cuid())
  classId String
  classSubjectId String
  dayOfWeek Int
  startTime String
  endTime String
  roomId String?
  class ClassSection @relation(fields: [classId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
}

model StudentAttendance {
  id String @id @default(cuid())
  studentId String
  subjectId String
  classId String
  date DateTime
  status AttendanceStatus
  remarks String?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class ClassSection @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@unique([studentId, subjectId, date])
}

model FacultyAttendance {
  id String @id @default(cuid())
  facultyId String
  date DateTime
  status AttendanceStatus
  remarks String?
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  @@unique([facultyId, date])
}

model Exam {
  id String @id @default(cuid())
  semesterId String
  subjectId String
  facultyId String?
  name String
  type ExamType
  totalMarks Float
  passingMarks Float
  examDate DateTime?
  startTime String?
  endTime String?
  status ExamStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  results Result[]
}

model Result {
  id String @id @default(cuid())
  examId String
  studentId String
  subjectId String
  marks Float
  grade String?
  gradePoint Float?
  status ResultStatus @default(PASS)
  remarks String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([examId, studentId])
}

model AdmissionApplication {
  id String @id @default(cuid())
  programId String
  applicationNo String @unique
  type ApplicationType @default(ONLINE)
  firstName String
  lastName String?
  email String
  phone String
  dateOfBirth DateTime?
  gender Gender?
  cnic String?
  address String?
  city String?
  previousQualification String?
  previousInstitution String?
  previousPercentage Float?
  status AdmissionStatus @default(PENDING)
  remarks String?
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  documents AdmissionDocument[]
}

model AdmissionDocument {
  id String @id @default(cuid())
  applicationId String
  type DocumentType
  fileUrl String
  fileName String?
  uploadedAt DateTime @default(now())
  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model FeeStructure {
  id String @id @default(cuid())
  programId String
  semesterId String?
  name String
  description String?
  amount Decimal @db.Decimal(12, 2)
  feeType FeeType
  dueDate DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  payments Payment[]
}

model Payment {
  id String @id @default(cuid())
  studentId String
  feeStructureId String
  invoiceNumber String @unique
  amount Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)
  method PaymentMethod?
  transactionId String?
  dueDate DateTime?
  paidAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
}

model Scholarship {
  id String @id @default(cuid())
  name String
  description String?
  type ScholarshipType
  percentage Float?
  fixedAmount Decimal? @db.Decimal(12, 2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students StudentScholarship[]
}

model StudentScholarship {
  id String @id @default(cuid())
  studentId String
  scholarshipId String
  amount Decimal? @db.Decimal(12, 2)
  startDate DateTime?
  endDate DateTime?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  @@unique([studentId, scholarshipId])
}

model ClinicalSite {
  id String @id @default(cuid())
  name String
  type ClinicalSiteType
  address String?
  city String?
  phone String?
  email String?
  contactPerson String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trainings ClinicalTraining[]
}

model ClinicalTraining {
  id String @id @default(cuid())
  studentId String
  siteId String
  facultyId String?
  department String?
  ward String?
  startDate DateTime
  endDate DateTime
  status ClinicalStatus @default(PLANNED)
  remarks String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  site ClinicalSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  faculty Faculty? @relation("ClinicalSupervisor", fields: [facultyId], references: [id], onDelete: SetNull)
}

model NursingSkill {
  id String @id @default(cuid())
  subjectId String?
  name String
  description String?
  category String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studentSkills StudentSkill[]
}

model StudentSkill {
  id String @id @default(cuid())
  studentId String
  skillId String
  verifiedBy String?
  status SkillStatus @default(NOT_STARTED)
  score Float?
  remarks String?
  assessedAt DateTime?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill NursingSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  verifier Faculty? @relation("SkillVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  @@unique([studentId, skillId])
}

// Optional hospital module. A college without a hospital simply has no Hospital rows.
model Hospital {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  departments HospitalDepartment[]
  wards       HospitalWard[]
  doctors     Doctor[]
  patients    Patient[]
  appointments Appointment[]
  prescriptions Prescription[]
  labTests    LabTest[]
  consultations Consultation[]
}

model HospitalDepartment {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String
  type        HospitalDepartmentType
  description String?
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors     Doctor[]
  wards       HospitalWard[]
  appointments Appointment[]
}

model HospitalWard {
  id          String   @id @default(cuid())
  hospitalId  String
  departmentId String?
  name        String
  floor       String?
  capacity    Int?
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department  HospitalDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  beds        HospitalBed[]
}

model HospitalBed {
  id          String          @id @default(cuid())
  wardId      String
  bedNumber   String
  type        HospitalBedType @default(GENERAL)
  status      BedStatus       @default(AVAILABLE)
  ward        HospitalWard    @relation(fields: [wardId], references: [id], onDelete: Cascade)
  patientAdmissions PatientAdmission[]
  @@unique([wardId, bedNumber])
}

model Doctor {
  id             String   @id @default(cuid())
  hospitalId     String
  departmentId   String?
  userId         String?  @unique
  name           String
  employeeId     String?
  specialization String?
  qualification  String?
  licenseNumber  String?
  phone          String?
  email          String?
  availability   String?  // e.g. "Mon-Fri: 09:00 - 15:00"
  isActive       Boolean  @default(true)
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department     HospitalDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  prescriptions  Prescription[]
  consultations  Consultation[]
}

model Patient {
  id               String        @id @default(cuid())
  hospitalId       String
  patientNo        String        // Medical Record Number (MRN)
  firstName        String
  lastName         String?
  dateOfBirth      DateTime?
  gender           Gender?
  phone            String?
  address          String?
  city             String?
  bloodGroup       String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalHistory   String?
  status           PatientStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  hospital         Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  admissions       PatientAdmission[]
  prescriptions    Prescription[]
  labTests         LabTest[]
  consultations    Consultation[]
  dispensingRecords DispensingRecord[]
  @@unique([hospitalId, patientNo])
}

model Appointment {
  id              String            @id @default(cuid())
  hospitalId      String
  patientId       String
  doctorId        String
  departmentId    String?
  appointmentDate DateTime
  reason          String?
  status          AppointmentStatus @default(SCHEDULED)
  tokenNumber     Int?
  notes           String?
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department      HospitalDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  consultation    Consultation?
}

model Consultation {
  id              String       @id @default(cuid())
  hospitalId      String
  appointmentId   String?      @unique
  patientId       String
  doctorId        String
  symptoms        String?
  diagnosis       String
  clinicalNotes   String?
  vitalSigns      Json?        // e.g. { bp: "120/80", pulse: 72, temp: 98.6, spo2: 99 }
  followUpDate    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
}

model PatientAdmission {
  id               String       @id @default(cuid())
  patientId        String
  bedId            String
  admittedAt       DateTime     @default(now())
  dischargedAt     DateTime?
  diagnosis        String?
  notes            String?
  dischargeSummary String?
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bed              HospitalBed  @relation(fields: [bedId], references: [id], onDelete: Restrict)
}

model Prescription {
  id             String             @id @default(cuid())
  hospitalId     String
  patientId      String
  doctorId       String
  prescriptionNo String
  date           DateTime           @default(now())
  diagnosis      String?
  notes          String?
  status         PrescriptionStatus @default(ACTIVE)
  hospital       Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  items          PrescriptionItem[]
  dispensingRecords DispensingRecord[]
  @@unique([hospitalId, prescriptionNo])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model LabTest {
  id          String        @id @default(cuid())
  hospitalId  String
  patientId   String
  testName    String
  requestedAt DateTime      @default(now())
  status      LabTestStatus @default(REQUESTED)
  result      String?
  normalRange String?
  remarks     String?
  completedAt DateTime?
  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Pharmacy {
  id          String     @id @default(cuid())
  name        String
  location    String?
  isActive    Boolean    @default(true)
  medicines   Medicine[]
  dispensingRecords DispensingRecord[]
}

model Medicine {
  id           String      @id @default(cuid())
  pharmacyId   String
  name         String      // Brand name
  genericName  String?
  category     String?
  strength     String?     // e.g. "500mg", "10mg/ml"
  dosageForm   String?     // "Tablet", "Capsule", "Syrup", "Injection"
  manufacturer String?
  unit         String?     // "Strip", "Bottle", "Box"
  quantity     Int         @default(0) // Total aggregated quantity
  reorderLevel Int         @default(10)
  purchasePrice Decimal?   @db.Decimal(10, 2)
  sellingPrice  Decimal?   @db.Decimal(10, 2)
  expiryDate   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pharmacy     Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  batches      MedicineBatch[]
  movements    MedicineStockMovement[]
  dispensedItems DispensedItem[]
}

model MedicineBatch {
  id            String    @id @default(cuid())
  medicineId    String
  batchNumber   String
  quantity      Int       @default(0)
  expiryDate    DateTime
  purchasePrice Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  medicine      Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  movements     MedicineStockMovement[]
  dispensedItems DispensedItem[]
  @@unique([medicineId, batchNumber])
}

model MedicineStockMovement {
  id          String                @id @default(cuid())
  medicineId  String
  batchId     String?
  type        MedicineMovementType
  quantity    Int                   // positive for inbound, negative/absolute for outbound
  reference   String?               // PO number, Invoice ID, or Dispense ID
  notes       String?
  performedBy String?
  createdAt   DateTime              @default(now())
  medicine    Medicine              @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batch       MedicineBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model DispensingRecord {
  id             String          @id @default(cuid())
  pharmacyId     String
  patientId      String?
  prescriptionId String?
  dispensedBy    String?
  totalAmount    Decimal         @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patient        Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  prescription   Prescription?   @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items          DispensedItem[]
}

model DispensedItem {
  id                 String           @id @default(cuid())
  dispensingRecordId String
  medicineId         String
  batchId            String?
  quantity           Int
  unitPrice          Decimal          @db.Decimal(10, 2)
  totalPrice         Decimal          @db.Decimal(10, 2)
  dispensingRecord   DispensingRecord @relation(fields: [dispensingRecordId], references: [id], onDelete: Cascade)
  medicine           Medicine         @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch              MedicineBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model Hostel {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  gender    Gender?
  address   String?
  status    HostelStatus @default(ACTIVE)
  rooms     HostelRoom[]
}

model HostelRoom {
  id         String         @id @default(cuid())
  hostelId   String
  roomNumber String
  floor      String?
  type       HostelRoomType @default(DOUBLE)
  capacity   Int            @default(2)
  hostel     Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  beds       HostelBed[]
  @@unique([hostelId, roomNumber])
}

model HostelBed {
  id          String             @id @default(cuid())
  roomId      String
  bedNumber   String
  isActive    Boolean            @default(true)
  room        HostelRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]
  @@unique([roomId, bedNumber])
}

model HostelAllocation {
  id          String               @id @default(cuid())
  studentId   String
  bedId       String
  startDate   DateTime
  endDate     DateTime?
  status      RoomAllocationStatus @default(ACTIVE)
  remarks     String?
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bed         HostelBed            @relation(fields: [bedId], references: [id], onDelete: Restrict)
}

model Library {
  id        String          @id @default(cuid())
  name      String
  location  String?
  isActive  Boolean         @default(true)
  books     LibraryBook[]
  members   LibraryMember[]
  issues    LibraryIssue[]
}

model LibraryBook {
  id              String          @id @default(cuid())
  libraryId       String
  isbn            String?
  title           String
  author          String?
  publisher       String?
  category        String?
  edition         String?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  library         Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copies          BookCopy[]
  issues          LibraryIssue[]
}

model BookCopy {
  id          String         @id @default(cuid())
  bookId      String
  accessionNo String         @unique // Barcode or physical copy ID (e.g. "FN-001")
  status      BookCopyStatus @default(AVAILABLE)
  condition   String?        // "Good", "Fair", "Damaged"
  createdAt   DateTime       @default(now())
  book        LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issues      LibraryIssue[]
}

model LibraryMember {
  id        String   @id @default(cuid())
  libraryId String
  studentId String
  memberNo  String
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([libraryId, memberNo])
  @@unique([libraryId, studentId])
}

model LibraryIssue {
  id         String      @id @default(cuid())
  libraryId  String
  bookId     String
  copyId     String?
  studentId  String
  issueDate  DateTime    @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     IssueStatus @default(ISSUED)
  fine       Decimal?    @db.Decimal(10, 2)
  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  copy       BookCopy?   @relation(fields: [copyId], references: [id], onDelete: SetNull)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id             String                @id @default(cuid())
  registrationNo String                @unique
  name           String?
  type           String?
  capacity       Int                   @default(30)
  driverName     String?
  driverPhone    String?
  status         VehicleStatus         @default(ACTIVE)
  routes         TransportRoute[]
  assignments    TransportAssignment[]
}

model TransportRoute {
  id          String                @id @default(cuid())
  vehicleId   String
  name        String
  startPoint  String?
  endPoint    String?
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  stops       TransportStop[]
}

model TransportStop {
  id          String                @id @default(cuid())
  routeId     String
  name        String
  sequence    Int
  pickupTime  String?
  route       TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments TransportAssignment[]
}

model TransportAssignment {
  id        String         @id @default(cuid())
  studentId String
  vehicleId String
  stopId    String?
  startDate DateTime
  endDate   DateTime?
  status    String         @default("ACTIVE")
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  stop      TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
}

model Employee {
  id            String          @id @default(cuid())
  userId        String?         @unique
  departmentId  String?
  employeeId    String          @unique
  firstName     String
  lastName      String?
  designation   String?
  qualification String?
  joiningDate   DateTime?
  leavingDate   DateTime?
  status        EmploymentStatus @default(ACTIVE)
  phone         String?
  email         String?
  basicSalary   Decimal?        @db.Decimal(12, 2)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaves        EmployeeLeave[]
  payrolls      Payroll[]
}

model EmployeeLeave {
  id          String      @id @default(cuid())
  employeeId  String
  leaveType   LeaveType   @default(CASUAL)
  startDate   DateTime
  endDate     DateTime
  days        Int         @default(1)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  createdAt   DateTime    @default(now())
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id             String        @id @default(cuid())
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal       @db.Decimal(12, 2)
  allowances     Decimal       @default(0) @db.Decimal(12, 2)
  bonuses        Decimal       @default(0) @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  netSalary      Decimal       @db.Decimal(12, 2)
  status         PayrollStatus @default(DRAFT)
  calculationLog Json?
  processedBy    String?
  approvedBy     String?
  paidAt         DateTime?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, month, year])
}

model InventoryCategory {
  id String @id @default(cuid())
  name String @unique
  description String?
  items InventoryItem[]
}

model InventoryItem {
  id String @id @default(cuid())
  categoryId String
  name String
  sku String? @unique
  description String?
  unit String?
  quantity Int @default(0)
  reorderLevel Int @default(0)
  category InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
}

model StockMovement {
  id String @id @default(cuid())
  itemId String
  type StockMovementType
  quantity Int
  reference String?
  notes String?
  createdAt DateTime @default(now())
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Supplier {
  id String @id @default(cuid())
  name String
  contactPerson String?
  phone String?
  email String?
  address String?
  isActive Boolean @default(true)
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id String @id @default(cuid())
  supplierId String
  orderNumber String @unique
  orderDate DateTime @default(now())
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  status PurchaseOrderStatus @default(DRAFT)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id String @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  quantity Int
  unitPrice Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
}

model Page {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String?
  content String
  status ContentStatus @default(DRAFT)
  metaTitle String?
  metaDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String?
  content String
  imageUrl String?
  status ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String?
  imageUrl String?
  location String?
  startDate DateTime
  endDate DateTime?
  status EventStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id String @id @default(cuid())
  title String
  content String
  attachmentUrl String?
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentDocument {
  id String @id @default(cuid())
  studentId String
  type DocumentType
  fileUrl String
  fileName String?
  uploadedAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CollegeDocument {
  id String @id @default(cuid())
  name String
  type DocumentType
  fileUrl String
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  message String
  type NotificationType
  status NotificationStatus @default(UNREAD)
  link String?
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Alumni {
  id String @id @default(cuid())
  studentId String @unique
  graduationYear Int?
  currentCompany String?
  currentPosition String?
  city String?
  country String?
  bio String?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Certificate {
  id String @id @default(cuid())
  studentId String
  certificateNo String
  type CertificateType
  title String
  description String?
  issueDate DateTime @default(now())
  fileUrl String?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([studentId, certificateNo])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  oldData Json?
  newData Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}
