# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pern_erp?schema=public"

# Redis Cache Configuration (Optional - falls back to In-Memory store if omitted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_KEY_PREFIX="pern:erp:"

# NestJS Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production
JWT_EXPIRES_IN=7d

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="PERN Multi-College ERP"
